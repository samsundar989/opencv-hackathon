# Shipped in the deploy tarball and read by riversight.live.cycle at start (the systemd environment wins).
# D-0012 / Q-0011 (a): rules act; Sonnet 4.6 gives a second opinion on anything that would page a human.
RIVERSIGHT_AGENT_MODE=rules_first
RIVERSIGHT_AGENT_ESCALATE=1
# D-0015 deploy (W5 as deploy owner, Oct 25):
# D-0014: v2 (DINOv2 in cv2.dnn) promoted under D-0010 §2; v1 runs beside it and keeps the frozen-v1 record
RIVERSIGHT_SERVE_V2=1
# Cowork ruling 2026-10-25 03:05 CT: plain fused filter on live (F.b = 0)
RIVERSIGHT_FUSED_BIAS=0
# D-0014 W4-1: weekly refit + hourly drift, shadow only; promotion needs an approved RECALIBRATE
RIVERSIGHT_RECAL=1
# ANSWER 0014: king-tide advisory failed its pre-registered test (0/4); off
RIVERSIGHT_TIDE_ADVISORY=0
# D-0014: Bedrock line, live only
RIVERSIGHT_AGENT_DAILY_TOKENS=150000
